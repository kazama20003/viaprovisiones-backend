generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoDocumento {
  dni
  ruc
  ce
  sin_documento
}

enum TipoCliente {
  consumidor
  minorista
  mayorista
  empresa
}

enum EstadoProducto {
  borrador
  publicado
  oculto
  descontinuado
}

enum EstadoCompra {
  borrador
  enviada
  en_transito
  recepcion_parcial
  recibida
  cancelada
}

enum EstadoCotizacion {
  borrador
  enviada
  en_negociacion
  aceptada
  rechazada
  vencida
  convertida
  cancelada
}

enum CanalPedido {
  tienda_web
  whatsapp
  empresas
  mostrador
  otro
}

enum EstadoPedido {
  por_pagar
  pagado
  preparando
  enviado
  entregado
  cancelado
}

enum EstadoPago {
  pendiente
  parcial
  pagado
  reembolsado
}

enum MetodoEntrega {
  delivery
  agencia
  recojo
}

enum EstadoComprobante {
  pendiente
  emitido
  aceptado
  rechazado
  anulado
}

enum EstadoCuenta {
  pendiente
  parcial
  pagada
  vencida
  anulada
}

enum EstadoSesionCaja {
  abierta
  cerrada
}

enum TipoMovimientoCaja {
  apertura
  cobro
  gasto
  retiro
  ingreso
  ajuste
}

enum SentidoMovimiento {
  entrada
  salida
}

enum TipoMovimientoInventario {
  recepcion
  venta
  reserva
  liberacion
  devolucion
  ajuste
  traslado_salida
  traslado_entrada
  reversion
}

enum EstadoLote {
  disponible
  en_revision
  bloqueado
  agotado
}

enum EstadoReserva {
  activa
  consumida
  liberada
}

enum EstadoTraslado {
  preparando
  en_camino
  recibido
  cancelado
}

enum EstadoDevolucion {
  solicitada
  aprobada
  rechazada
  recibida
  reembolsada
}

enum EstadoEnvio {
  pendiente
  preparado
  despachado
  en_transito
  entregado
  fallido
  devuelto
  cancelado
}

enum EstadoReembolso {
  solicitado
  aprobado
  procesado
  rechazado
}

enum TipoMedioPago {
  efectivo
  transferencia
  tarjeta
  billetera_digital
  credito
  otro
}

enum EstadoProductoDevuelto {
  apto_para_venta
  en_revision
  desechado
}

enum TipoDescuento {
  porcentaje
  monto_fijo
  precio_especial
}

model Empresa {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruc                  String?                    @unique @db.VarChar(11)
  razonSocial          String                     @map("razon_social") @db.VarChar(180)
  nombreComercial      String                     @map("nombre_comercial") @db.VarChar(180)
  correo               String?                    @db.VarChar(254)
  telefono             String?                    @db.VarChar(30)
  direccion            String?                    @db.VarChar(250)
  moneda               String                     @default("PEN") @db.Char(3)
  tasaIgv              Decimal                    @default(0.18) @map("tasa_igv") @db.Decimal(5, 4)
  creadaEn             DateTime                   @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadaEn        DateTime                   @updatedAt @map("actualizada_en") @db.Timestamptz(6)
  usuarios             Usuario[]
  roles                Rol[]
  clientes             Cliente[]
  proveedores          Proveedor[]
  categorias           Categoria[]
  marcas               Marca[]
  productos            Producto[]
  listasPrecios        ListaPrecios[]
  almacenes            Almacen[]
  ordenesCompra        OrdenCompra[]
  recepcionesCompra    RecepcionCompra[]
  detallesRecepcion    DetalleRecepcion[]
  lotes                Lote[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  comprobantes         Comprobante[]
  cuentasPorCobrar     CuentaPorCobrar[]
  cuentasPorPagar      CuentaPorPagar[]
  sesionesCaja         SesionCaja[]
  gastos               Gasto[]
  cobros               Cobro[]
  movimientosCaja      MovimientoCaja[]
  movimientosStock     MovimientoInventario[]
  reservasStock        ReservaInventario[]
  traslados            Traslado[]
  devoluciones         Devolucion[]
  promociones          Promocion[]
  banners              Banner[]
  historialEstados     HistorialEstadoDocumento[]
  auditoria            RegistroAuditoria[]
  variantesProducto    VarianteProducto[]
  existenciasLote      ExistenciaLote[]
  sesionesUsuario      SesionUsuario[]
  envios               EnvioPedido[]
  mediosPago           MedioPago[]
  configuracionTienda  ConfiguracionTienda?
  promocionesAplicadas PromocionPedido[]
  reembolsos           Reembolso[]

  @@map("empresas")
}

model Usuario {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId                 String                     @map("empresa_id") @db.Uuid
  nombre                    String                     @db.VarChar(160)
  correo                    String                     @db.VarChar(254)
  claveCifrada              String                     @map("clave_cifrada")
  activo                    Boolean                    @default(true)
  ultimoAccesoEn            DateTime?                  @map("ultimo_acceso_en") @db.Timestamptz(6)
  creadoEn                  DateTime                   @default(now()) @map("creado_en") @db.Timestamptz(6)
  empresa                   Empresa                    @relation(fields: [empresaId], references: [id])
  roles                     UsuarioRol[]
  ordenesCreadas            OrdenCompra[]              @relation("OrdenCompraCreador")
  recepcionesRegistradas    RecepcionCompra[]          @relation("RecepcionRegistrador")
  cotizacionesCreadas       Cotizacion[]               @relation("CotizacionCreador")
  pedidosAtendidos          Pedido[]                   @relation("PedidoVendedor")
  cajasAbiertas             SesionCaja[]               @relation("CajaApertura")
  cajasCerradas             SesionCaja[]               @relation("CajaCierre")
  gastosRegistrados         Gasto[]
  cobrosRegistrados         Cobro[]
  pagosProveedorRegistrados PagoProveedor[]
  movimientosCaja           MovimientoCaja[]
  movimientosInventario     MovimientoInventario[]
  trasladosCreados          Traslado[]                 @relation("TrasladoCreador")
  trasladosRecibidos        Traslado[]                 @relation("TrasladoReceptor")
  devolucionesCreadas       Devolucion[]
  cambiosEstado             HistorialEstadoDocumento[]
  auditorias                RegistroAuditoria[]
  sesiones                  SesionUsuario[]

  @@unique([empresaId, correo])
  @@unique([id, empresaId])
  @@map("usuarios")
}

model Rol {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String       @map("empresa_id") @db.Uuid
  nombre      String       @db.VarChar(80)
  descripcion String?      @db.VarChar(250)
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  usuarios    UsuarioRol[]
  permisos    RolPermiso[]

  @@unique([empresaId, nombre])
  @@unique([id, empresaId])
  @@map("roles")
}

model Permiso {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String       @unique @db.VarChar(100)
  descripcion String       @db.VarChar(250)
  roles       RolPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  empresaId String  @map("empresa_id") @db.Uuid
  usuarioId String  @map("usuario_id") @db.Uuid
  rolId     String  @map("rol_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

model RolPermiso {
  rolId     String  @map("rol_id") @db.Uuid
  permisoId String  @map("permiso_id") @db.Uuid
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model Cliente {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String             @map("empresa_id") @db.Uuid
  tipoDocumento     TipoDocumento      @default(sin_documento) @map("tipo_documento")
  numeroDocumento   String?            @map("numero_documento") @db.VarChar(20)
  tipoCliente       TipoCliente        @default(consumidor) @map("tipo_cliente")
  nombre            String             @db.VarChar(180)
  razonSocial       String?            @map("razon_social") @db.VarChar(180)
  correo            String?            @db.VarChar(254)
  telefono          String?            @db.VarChar(30)
  limiteCredito     Decimal            @default(0) @map("limite_credito") @db.Decimal(14, 2)
  condicionPagoDias Int                @default(0) @map("condicion_pago_dias") @db.SmallInt
  activo            Boolean            @default(true)
  creadoEn          DateTime           @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn     DateTime           @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  direcciones       DireccionCliente[]
  cotizaciones      Cotizacion[]
  pedidos           Pedido[]
  cuentasPorCobrar  CuentaPorCobrar[]

  @@unique([empresaId, tipoDocumento, numeroDocumento])
  @@unique([id, empresaId])
  @@map("clientes")
}

model DireccionCliente {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId    String   @map("cliente_id") @db.Uuid
  alias        String?  @db.VarChar(80)
  direccion    String   @db.VarChar(250)
  referencia   String?  @db.VarChar(250)
  distrito     String?  @db.VarChar(100)
  provincia    String?  @db.VarChar(100)
  departamento String?  @db.VarChar(100)
  esPrincipal  Boolean  @default(false) @map("es_principal")
  creadaEn     DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("direcciones_clientes")
}

model Proveedor {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String           @map("empresa_id") @db.Uuid
  tipoDocumento     TipoDocumento    @default(ruc) @map("tipo_documento")
  numeroDocumento   String?          @map("numero_documento") @db.VarChar(20)
  nombre            String           @db.VarChar(180)
  razonSocial       String?          @map("razon_social") @db.VarChar(180)
  correo            String?          @db.VarChar(254)
  telefono          String?          @db.VarChar(30)
  direccion         String?          @db.VarChar(250)
  condicionPagoDias Int              @default(0) @map("condicion_pago_dias") @db.SmallInt
  activo            Boolean          @default(true)
  creadoEn          DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)
  empresa           Empresa          @relation(fields: [empresaId], references: [id])
  ordenesCompra     OrdenCompra[]
  lotes             Lote[]
  cuentasPorPagar   CuentaPorPagar[]

  @@unique([empresaId, tipoDocumento, numeroDocumento])
  @@unique([id, empresaId])
  @@map("proveedores")
}

model Marca {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  nombre    String  @db.VarChar(100)
  activa    Boolean @default(true)
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nombre])
  @@map("marcas")
}

model Categoria {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String      @map("empresa_id") @db.Uuid
  categoriaPadreId String?     @map("categoria_padre_id") @db.Uuid
  nombre           String      @db.VarChar(120)
  descripcion      String?     @db.VarChar(300)
  activa           Boolean     @default(true)
  empresa          Empresa     @relation(fields: [empresaId], references: [id])
  categoriaPadre   Categoria?  @relation("CategoriaJerarquia", fields: [categoriaPadreId], references: [id])
  subcategorias    Categoria[] @relation("CategoriaJerarquia")
  productos        Producto[]

  @@unique([empresaId, nombre])
  @@unique([id, empresaId])
  @@map("categorias")
}

model Producto {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String                 @map("empresa_id") @db.Uuid
  categoriaId        String?                @map("categoria_id") @db.Uuid
  sku                String                 @db.VarChar(60)
  codigoBarras       String?                @map("codigo_barras") @db.VarChar(80)
  nombre             String                 @db.VarChar(180)
  descripcion        String?
  marca              String?                @db.VarChar(100)
  unidadMedida       String                 @default("unidad") @map("unidad_medida") @db.VarChar(20)
  tasaIgv            Decimal                @default(0.18) @map("tasa_igv") @db.Decimal(5, 4)
  stockMinimo        Decimal                @default(0) @map("stock_minimo") @db.Decimal(14, 3)
  estado             EstadoProducto         @default(borrador)
  visibleEnTienda    Boolean                @default(false) @map("visible_en_tienda")
  destacado          Boolean                @default(false)
  permiteDelivery    Boolean                @default(true) @map("permite_delivery")
  permiteAgencia     Boolean                @default(true) @map("permite_agencia")
  permiteRecojo      Boolean                @default(true) @map("permite_recojo")
  datosAdicionales   Json                   @default("{}") @map("datos_adicionales")
  creadoEn           DateTime               @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn      DateTime               @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  empresa            Empresa                @relation(fields: [empresaId], references: [id])
  categoria          Categoria?             @relation(fields: [categoriaId], references: [id])
  imagenes           ImagenProducto[]
  precios            PrecioProducto[]
  lineasCompra       LineaOrdenCompra[]
  lotes              Lote[]
  lineasCotizacion   LineaCotizacion[]
  lineasPedido       LineaPedido[]
  movimientosStock   MovimientoInventario[]
  lineasTraslado     LineaTraslado[]
  variantes          VarianteProducto[]
  promocionProductos PromocionProducto[]
  historial          HistorialProducto[]
  archivos           ArchivoProducto[]

  @@unique([empresaId, sku])
  @@unique([id, empresaId])
  @@map("productos")
}

model ArchivoProducto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId String   @map("producto_id") @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  objeto     String   @unique
  tipo       String   @db.VarChar(10)
  mime       String   @db.VarChar(80)
  tamano     Int
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId, creadoEn])
  @@map("archivos_productos")
}

model HistorialProducto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId String   @map("producto_id") @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  accion     String   @db.VarChar(80)
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId, creadoEn(sort: Desc)])
  @@map("historial_productos")
}

model VarianteProducto {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String             @map("empresa_id") @db.Uuid
  productoId       String             @map("producto_id") @db.Uuid
  sku              String             @db.VarChar(60)
  codigoBarras     String?            @map("codigo_barras") @db.VarChar(80)
  atributos        Json               @default("{}")
  precioPublico    Decimal?           @map("precio_publico") @db.Decimal(14, 4)
  activa           Boolean            @default(true)
  creadoEn         DateTime           @default(now()) @map("creado_en") @db.Timestamptz(6)
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  producto         Producto           @relation(fields: [productoId], references: [id], onDelete: Cascade)
  lineasCompra     LineaOrdenCompra[]
  lineasCotizacion LineaCotizacion[]
  lineasPedido     LineaPedido[]
  lotes            Lote[]
  precios          PrecioProducto[]

  @@unique([empresaId, sku])
  @@unique([id, empresaId])
  @@index([productoId, activa])
  @@map("variantes_producto")
}

model ImagenProducto {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId       String   @map("producto_id") @db.Uuid
  url              String
  textoAlternativo String?  @map("texto_alternativo") @db.VarChar(180)
  posicion         Int      @default(0) @db.SmallInt
  esPrincipal      Boolean  @default(false) @map("es_principal")
  producto         Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, posicion])
  @@map("imagenes_productos")
}

model ListaPrecios {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String           @map("empresa_id") @db.Uuid
  nombre      String           @db.VarChar(100)
  tipoCliente TipoCliente?     @map("tipo_cliente")
  activa      Boolean          @default(true)
  empresa     Empresa          @relation(fields: [empresaId], references: [id])
  precios     PrecioProducto[]

  @@unique([empresaId, nombre])
  @@unique([id, empresaId])
  @@map("listas_precios")
}

model PrecioProducto {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listaPreciosId String            @map("lista_precios_id") @db.Uuid
  productoId     String            @map("producto_id") @db.Uuid
  varianteId     String?           @map("variante_id") @db.Uuid
  cantidadMinima Decimal           @default(1) @map("cantidad_minima") @db.Decimal(14, 3)
  precioUnitario Decimal           @map("precio_unitario") @db.Decimal(14, 4)
  vigenteDesde   DateTime          @default(now()) @map("vigente_desde") @db.Timestamptz(6)
  vigenteHasta   DateTime?         @map("vigente_hasta") @db.Timestamptz(6)
  listaPrecios   ListaPrecios      @relation(fields: [listaPreciosId], references: [id])
  producto       Producto          @relation(fields: [productoId], references: [id])
  variante       VarianteProducto? @relation(fields: [varianteId], references: [id])

  @@unique([listaPreciosId, productoId, cantidadMinima, vigenteDesde])
  @@index([varianteId, vigenteDesde])
  @@map("precios_productos")
}

model Almacen {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String                 @map("empresa_id") @db.Uuid
  codigo            String                 @db.VarChar(30)
  nombre            String                 @db.VarChar(120)
  direccion         String?                @db.VarChar(250)
  activo            Boolean                @default(true)
  empresa           Empresa                @relation(fields: [empresaId], references: [id])
  existencias       ExistenciaLote[]
  detallesRecepcion DetalleRecepcion[]
  sesionesCaja      SesionCaja[]
  trasladosOrigen   Traslado[]             @relation("AlmacenOrigen")
  trasladosDestino  Traslado[]             @relation("AlmacenDestino")
  movimientosStock  MovimientoInventario[]

  @@unique([empresaId, codigo])
  @@unique([id, empresaId])
  @@map("almacenes")
}

model OrdenCompra {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId            String             @map("empresa_id") @db.Uuid
  proveedorId          String             @map("proveedor_id") @db.Uuid
  creadaPorId          String?            @map("creada_por") @db.Uuid
  numero               String             @db.VarChar(30)
  estado               EstadoCompra       @default(borrador)
  moneda               String             @default("PEN") @db.Char(3)
  condicionPago        String?            @map("condicion_pago") @db.VarChar(120)
  fechaEmision         DateTime           @default(now()) @map("fecha_emision") @db.Date
  fechaEntregaPrevista DateTime?          @map("fecha_entrega_prevista") @db.Date
  subtotal             Decimal            @default(0) @db.Decimal(14, 2)
  impuesto             Decimal            @default(0) @db.Decimal(14, 2)
  total                Decimal            @default(0) @db.Decimal(14, 2)
  observaciones        String?
  creadaEn             DateTime           @default(now()) @map("creada_en") @db.Timestamptz(6)
  empresa              Empresa            @relation(fields: [empresaId], references: [id])
  proveedor            Proveedor          @relation(fields: [proveedorId], references: [id])
  creadaPor            Usuario?           @relation("OrdenCompraCreador", fields: [creadaPorId], references: [id])
  lineas               LineaOrdenCompra[]
  recepciones          RecepcionCompra[]
  cuentaPorPagar       CuentaPorPagar?

  @@unique([empresaId, numero])
  @@unique([id, empresaId])
  @@index([empresaId, estado, fechaEmision(sort: Desc)])
  @@map("ordenes_compra")
}

model LineaOrdenCompra {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordenCompraId     String             @map("orden_compra_id") @db.Uuid
  productoId        String             @map("producto_id") @db.Uuid
  varianteId        String?            @map("variante_id") @db.Uuid
  cantidadPedida    Decimal            @map("cantidad_pedida") @db.Decimal(14, 3)
  cantidadRecibida  Decimal            @default(0) @map("cantidad_recibida") @db.Decimal(14, 3)
  costoUnitario     Decimal            @map("costo_unitario") @db.Decimal(14, 4)
  tasaIgv           Decimal            @default(0.18) @map("tasa_igv") @db.Decimal(5, 4)
  ordenCompra       OrdenCompra        @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto          Producto           @relation(fields: [productoId], references: [id])
  variante          VarianteProducto?  @relation(fields: [varianteId], references: [id])
  detallesRecepcion DetalleRecepcion[]

  @@map("lineas_orden_compra")
}

model RecepcionCompra {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String             @map("empresa_id") @db.Uuid
  ordenCompraId String             @map("orden_compra_id") @db.Uuid
  recibidaPorId String?            @map("recibida_por") @db.Uuid
  numero        String             @db.VarChar(30)
