  pedidoId          String        @map("pedido_id") @db.Uuid
  lineaPedidoId     String        @map("linea_pedido_id") @db.Uuid
  loteId            String        @map("lote_id") @db.Uuid
  cantidad          Decimal       @db.Decimal(14, 3)
  estado            EstadoReserva @default(activa)
  claveIdempotencia String?       @map("clave_idempotencia") @db.VarChar(120)
  expiraEn          DateTime?     @map("expira_en") @db.Timestamptz(6)
  creadaEn          DateTime      @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadaEn     DateTime      @updatedAt @map("actualizada_en") @db.Timestamptz(6)
  empresa           Empresa       @relation(fields: [empresaId], references: [id])
  pedido            Pedido        @relation(fields: [pedidoId], references: [id])
  lineaPedido       LineaPedido   @relation(fields: [lineaPedidoId], references: [id])
  lote              Lote          @relation(fields: [loteId], references: [id])

  @@unique([empresaId, claveIdempotencia])
  @@index([estado, expiraEn])
  @@map("reservas_inventario")
}

model Traslado {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String                 @map("empresa_id") @db.Uuid
  almacenOrigenId  String                 @map("almacen_origen_id") @db.Uuid
  almacenDestinoId String                 @map("almacen_destino_id") @db.Uuid
  creadoPorId      String                 @map("creado_por") @db.Uuid
  recibidoPorId    String?                @map("recibido_por") @db.Uuid
  numero           String                 @db.VarChar(30)
  estado           EstadoTraslado         @default(preparando)
  creadoEn         DateTime               @default(now()) @map("creado_en") @db.Timestamptz(6)
  recibidoEn       DateTime?              @map("recibido_en") @db.Timestamptz(6)
  observaciones    String?
  empresa          Empresa                @relation(fields: [empresaId], references: [id])
  almacenOrigen    Almacen                @relation("AlmacenOrigen", fields: [almacenOrigenId], references: [id])
  almacenDestino   Almacen                @relation("AlmacenDestino", fields: [almacenDestinoId], references: [id])
  creadoPor        Usuario                @relation("TrasladoCreador", fields: [creadoPorId], references: [id])
  recibidoPor      Usuario?               @relation("TrasladoReceptor", fields: [recibidoPorId], references: [id])
  lineas           LineaTraslado[]
  movimientos      MovimientoInventario[]

  @@unique([empresaId, numero])
  @@map("traslados")
}

model LineaTraslado {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trasladoId       String   @map("traslado_id") @db.Uuid
  productoId       String   @map("producto_id") @db.Uuid
  loteId           String   @map("lote_id") @db.Uuid
  cantidadEnviada  Decimal  @map("cantidad_enviada") @db.Decimal(14, 3)
  cantidadRecibida Decimal  @default(0) @map("cantidad_recibida") @db.Decimal(14, 3)
  traslado         Traslado @relation(fields: [trasladoId], references: [id], onDelete: Cascade)
  producto         Producto @relation(fields: [productoId], references: [id])
  lote             Lote     @relation(fields: [loteId], references: [id])

  @@map("lineas_traslado")
}

model Devolucion {
