}

model Promocion {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String              @map("empresa_id") @db.Uuid
  nombre           String              @db.VarChar(120)
  codigo           String?             @db.VarChar(40)
  tipoDescuento    TipoDescuento       @map("tipo_descuento")
  valor            Decimal             @db.Decimal(14, 4)
  compraMinima     Decimal             @default(0) @map("compra_minima") @db.Decimal(14, 2)
  usosMaximos      Int?                @map("usos_maximos")
  usosActuales     Int                 @default(0) @map("usos_actuales")
  vigenteDesde     DateTime            @map("vigente_desde") @db.Timestamptz(6)
  vigenteHasta     DateTime?           @map("vigente_hasta") @db.Timestamptz(6)
