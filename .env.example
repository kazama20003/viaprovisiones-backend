DATABASE_URL="postgresql://usuario:clave@localhost:5432/viaprovisiones?schema=public"
PORT=3002
FRONTEND_URL="http://localhost:3001"
# Nombre del bucket privado de Google Cloud Storage (sin gs://).
GCS_BUCKET=""
# Opcional: proyecto de Google Cloud si no se deduce de las credenciales.
GOOGLE_CLOUD_PROJECT=""
# En local, ruta absoluta al archivo de credenciales si no usas ADC de gcloud.
GOOGLE_APPLICATION_CREDENTIALS=""
# UUID de la empresa cuyo catálogo público se muestra en la tienda.
EMPRESA_ID=""
# Configuración de una sola ejecución: pnpm db:bootstrap crea/actualiza la empresa y el usuario.
BOOTSTRAP_RUC=""
BOOTSTRAP_RAZON_SOCIAL=""
BOOTSTRAP_NOMBRE_COMERCIAL=""
BOOTSTRAP_ADMIN_NOMBRE=""
BOOTSTRAP_ADMIN_CORREO=""
BOOTSTRAP_ADMIN_CLAVE=""
